# Copy this file to ".env" and fill in real values, then restart the API server.
#   cp .env.example .env

# ─── Twilio (primary SMS provider) ───
# Get these from https://console.twilio.com  (Account SID, Auth Token, and a Twilio number).
# IMPORTANT: On a Twilio *trial* account you can ONLY send SMS to phone numbers you have
# verified under Console → Phone Numbers → Verified Caller IDs. Unverified numbers are rejected.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Fast2SMS (optional India fallback, used only if Twilio is not set) ───
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Default country code prepended to bare 10-digit mobile numbers (India = +91).
DEFAULT_COUNTRY_CODE=+91

# When true, the OTP is returned in the API response ONLY when SMS delivery is not
# configured or fails — so you can still demo the reset flow. Set to false in production.
SMS_DEBUG=true

# ─── Authentication / security ───
# JWT signing secret. MUST be a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# Token lifetime in hours.
JWT_EXPIRE_HOURS=12
# Shared key required to create a Scout/Official account (keeps athlete PII protected).
OFFICIAL_SIGNUP_KEY=SAI-OFFICIAL-2026
# HMAC key used to sign verifiable certificates. Defaults to JWT_SECRET_KEY if left unset.
# CERT_SIGNING_KEY=
# Public base URL embedded in certificate QR verification links (/api/v1/verify/{id}).
# Set this to your deployed backend URL in production so scanned QR codes resolve publicly.
# PUBLIC_BASE_URL=http://localhost:8000

# ─── CORS ───
# Comma-separated list of browser origins allowed to call the API.
# Add your deployed frontend URL here. Never use "*" with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: override the database location.
# DATABASE_URL=sqlite:///./sih_assessment.db
